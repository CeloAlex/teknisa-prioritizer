generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Issue {
  id               Int       @id
  nome             String
  categoria        String?
  cliente          String?
  produto          String?
  status           String?
  dataAbertura     DateTime?
  roadmap          Boolean   @default(false)
  atendeMultiplos  Boolean   @default(false)
  valor            Float?
  curva            String?
  observacao       String?
  descricao        String?
  impeditiva       Boolean   @default(false)
  aprovacao        String?
  motivoReprovacao String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  especificacao    Especificacao?
}

model Client {
  id                   Int                   @id @default(autoincrement())
  nome                 String                @unique
  codigo               String?
  aceite               DateTime?
  faturamento          Float?
  tipo                 String?
  curva                String?
  riscoChurn           Boolean               @default(false)
  projeto              Boolean               @default(false)
  qtdImpeditivas       Int                   @default(0)
  faturamentoSegmentos FaturamentoSegmento[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model FaturamentoSegmento {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  cliente    Client   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  segmentoId Int
  segmento   Segmento @relation(fields: [segmentoId], references: [id], onDelete: Cascade)
  valor      Float

  @@unique([clienteId, segmentoId])
}

model Depara {
  id               Int    @id @default(autoincrement())
  nomeCliente      String
  nomeClienteIssue String

  @@unique([nomeCliente, nomeClienteIssue])
}

model Segmento {
  id                   Int                   @id @default(autoincrement())
  nome                 String                @unique
  produtos             Produto[]
  criterios            Criterio[]
  faturamentoSegmentos FaturamentoSegmento[]
  operadores           Operador[]            @relation("OperadorSegmentos")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

enum PapelOperador {
  ADMIN
  EDITOR
  READONLY
}

model Operador {
  id                    Int             @id @default(autoincrement())
  nome                  String
  email                 String          @unique
  senhaHash             String
  papel                 PapelOperador
  ativo                 Boolean         @default(true)
  deveTrocarSenha       Boolean         @default(true)
  segmentos             Segmento[]      @relation("OperadorSegmentos")
  especificacoesGeradas Especificacao[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String   @unique
  segmentoId Int
  segmento   Segmento @relation(fields: [segmentoId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Criterio {
  id         Int       @id @default(autoincrement())
  nome       String
  peso       Int       @default(0)
  tipo       String
  atributo   String
  valor      String?
  direcao    String    @default("desc")
  ativo      Boolean   @default(true)
  padrao     Boolean   @default(false)
  segmentoId Int?
  segmento   Segmento? @relation(fields: [segmentoId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Especificacao {
  id               Int      @id @default(autoincrement())
  issueId          Int      @unique
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  contexto         String?
  requisitos       Json
  horasProgramacao Float
  horasTeste       Float
  docx             Bytes
  pdf              Bytes
  geradoPorId      Int?
  geradoPor        Operador? @relation(fields: [geradoPorId], references: [id])
  createdAt        DateTime @default(now())
  anexos           EspecificacaoAnexo[]
}

model EspecificacaoAnexo {
  id              Int           @id @default(autoincrement())
  especificacaoId Int
  especificacao   Especificacao @relation(fields: [especificacaoId], references: [id], onDelete: Cascade)
  nomeArquivo     String
  mimeType        String
  dadosOriginais  Bytes
  dadosEditados   Bytes?
}

model ParametroLLM {
  id           Int      @id @default(autoincrement())
  provider     String   @unique @default("openai")
  apiKey       String
  modeloTexto  String   @default("gpt-4o")
  modeloImagem String   @default("gpt-image-1")
  updatedAt    DateTime @updatedAt
}
